# Copie ce fichier en .env (ou exporte ces variables) avant de lancer le service.
# Aucune de ces valeurs n'est un secret : le service ne parle qu'a Ollama en local.

# Modele d'embeddings. Deux valeurs supportees, toutes deux de dimension 1024 :
#   qwen3-embedding:0.6b  -> tire parti d'une consigne d'instruction sur les requetes
#   bge-m3                -> n'en veut pas
# Changer cette ligne change les vecteurs, donc l'index, donc les reponses :
# il faut REINDEXER le corpus apres, sinon la panne est silencieuse.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Adresse d'Ollama. Depuis un conteneur, utiliser http://host.docker.internal:11434
# (Ollama sur la machine hote) ou http://ollama:11434 (profil docker "ollama").
OLLAMA_URL=http://localhost:11434

# Delai maximal d'un appel d'embedding, en secondes. Le premier appel apres un
# demarrage a froid d'Ollama peut etre long : le modele se charge en memoire.
OLLAMA_TIMEOUT_SECONDS=120

# Repertoire de persistance de l'index (matrice numpy + metadonnees JSON).
# Vide = python/embeddings_service/data
DATA_DIR=

# Prechauffage du modele au demarrage (1 = oui). C'est l'un des trois arguments
# en faveur du service HTTP plutot que d'un sous-processus : on paie le
# chargement des poids une seule fois.
WARMUP_ON_STARTUP=1

# Ecoute du serveur.
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8088

# Uniquement pour un modele hors de la liste supportee : declare sa dimension
# (et, si besoin, sa consigne d'instruction pour les requetes).
# EMBEDDING_DIMENSION=1024
# EMBEDDING_QUERY_INSTRUCTION=
